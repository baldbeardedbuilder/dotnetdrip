---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import ArchiveSection from "../../components/ArchiveSection.astro";
import type { GetStaticPaths } from "astro";
import { isDripPublished } from "../../scripts/publish";

export const getStaticPaths = (async () => {
  const allDrips = await getCollection("drips");
  
  // Filter to only published drips (8 AM Central Time)
  const publishedDrips = allDrips.filter((drip) => {
    const dateStr = drip.id.replace('/index', '');
    return isDripPublished(dateStr);
  });
  
  return publishedDrips.map((drip) => {
    const dateStr = drip.id.replace('/index', '');
    return {
      params: { date: dateStr },
      props: { drip },
    };
  });
}) satisfies GetStaticPaths;

const { drip } = Astro.props;
const dateStr = drip.id.replace('/index', '');
const [year, month, day] = dateStr.split('-').map(Number);
const dripDate = new Date(year, month - 1, day);
const formattedDate = dripDate.toLocaleDateString('en-US', { 
  year: 'numeric', 
  month: 'long', 
  day: 'numeric',
  weekday: 'long'
});

const  
  title = `Drip for ${formattedDate}`, 
  description = `Your regular dose of C# and .NET programming insights, tutorials, and community news for ${formattedDate}`,
	permalink = `https://dotnetdrip.com/archive/${dateStr}/`,
	ographTitle = `Your regular dose of C# and .NET programming insights, tutorials, and community news for \n${formattedDate}`	
;
---

<Layout {title} {description} {permalink} {ographTitle}>
  <!-- Header -->
  <header class="sticky top-0 z-40 bg-background/80 backdrop-blur-lg border-b border-border">
    <div class="max-w-6xl mx-auto px-6 py-4">
      <div class="flex items-center justify-end">
        <a href="/" class="logo-link group relative flex items-center gap-2" aria-label="Back to Home">
          <span class="logo-tooltip absolute right-full mr-3 px-2 py-0.5 bg-purple-600/90 text-white text-[11px] font-medium rounded whitespace-nowrap opacity-0 translate-x-2 pointer-events-none transition-all duration-300 group-hover:opacity-100 group-hover:translate-x-0">
            Back to Home
          </span>
          <img src="/images/logo.svg" alt=".NETdrip Logo" class="h-8 w-8" />
          <div class="flex items-baseline">
            <span class="text-xl font-bold text-primary">.NET</span>
            <span class="text-xl font-light text-primary-light">drip</span>
          </div>
        </a>
      </div>
    </div>
  </header>

  <!-- Main content -->
  <main id="main-content" class="relative py-8 sm:py-16 px-4 sm:px-6 min-h-screen">
    <!-- Background elements -->
    <div class="fixed inset-0 pointer-events-none overflow-hidden">
      <div class="absolute top-0 right-0 w-[800px] h-[800px] bg-gradient-to-br from-purple-400/20 via-indigo-400/10 to-transparent rounded-full blur-3xl animate-pulse" style="animation-duration: 8s;"></div>
      <div class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-gradient-to-tr from-indigo-400/20 via-purple-400/10 to-transparent rounded-full blur-3xl animate-pulse" style="animation-duration: 10s; animation-delay: 1s;"></div>
    </div>

    <div class="max-w-4xl mx-auto relative z-10">
      <!-- Page header -->
      <div class="text-center mb-8 sm:mb-12">
        <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-gradient-to-br from-purple-500 to-indigo-600 mb-6">
          <svg 
            class="w-10 h-10 text-white" 
            fill="none" 
            stroke="currentColor" 
            viewBox="0 0 24 24"
          >
            <path 
              stroke-linecap="round" 
              stroke-linejoin="round" 
              stroke-width="2" 
              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" 
            />
          </svg>
        </div>
        <h1 class="text-2xl sm:text-3xl font-bold mb-4 bg-gradient-to-r from-purple-600 to-indigo-600 dark:from-purple-400 dark:to-indigo-400 bg-clip-text text-transparent">
          {formattedDate}
        </h1>
        <p class="text-lg text-text-secondary max-w-2xl mx-auto">
          Browse through the links of this newsletter that is packed with C# and .NET insights
        </p>
      </div>

      <!-- Archive Section -->
      <ArchiveSection drip={drip} formattedDate={formattedDate} />
    </div>
  </main>
</Layout>

<style is:global>
  .logo-tooltip::after {
    content: '';
    position: absolute;
    top: 50%;
    right: -8px;
    transform: translateY(-50%);
    border-width: 5px;
    border-style: solid;
    border-color: transparent;
    border-left-color: rgba(147, 51, 234, 0.9);
  }
</style>
