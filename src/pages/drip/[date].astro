---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async () => {
  const allDrips = await getCollection("drips");
  
  return allDrips.map((drip) => {
    const dateStr = drip.id.replace('/index', '');
    return {
      params: { date: dateStr },
      props: { drip },
    };
  });
}) satisfies GetStaticPaths;

const { drip } = Astro.props;
const dateStr = drip.id.replace('/index', '');
const [year, month, day] = dateStr.split('-').map(Number);
const dripDate = new Date(year, month - 1, day);
const formattedDate = dripDate.toLocaleDateString('en-US', { 
  year: 'numeric', 
  month: 'long', 
  day: 'numeric',
  weekday: 'long'
});
---

<Layout title={`.NET drip - ${formattedDate}`}>
  <!-- Header -->
  <header class="sticky top-0 z-40 bg-background/80 backdrop-blur-lg border-b border-border">
    <div class="max-w-6xl mx-auto px-6 py-4">
      <div class="flex items-center justify-between">
        <a
          href="/archive"
          class="flex items-center gap-2 text-text-secondary hover:text-text-primary transition-colors group"
        >
          <svg class="w-5 h-5 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span>Back to Archive</span>
        </a>
        <a href="/" class="flex items-center gap-2">
          <img src="/images/logo.svg" alt=".NETdrip Logo" class="h-8 w-8" />
          <div class="flex items-baseline">
            <span class="text-xl font-bold text-primary">.NET</span>
            <span class="text-xl font-light text-primary-light">drip</span>
          </div>
        </a>
      </div>
    </div>
  </header>

  <!-- Main content -->
  <main class="relative py-16 px-6 min-h-screen">
    <!-- Background elements -->
    <div class="fixed inset-0 pointer-events-none overflow-hidden">
      <div class="absolute top-0 right-0 w-[800px] h-[800px] bg-gradient-to-br from-purple-400/20 via-indigo-400/10 to-transparent rounded-full blur-3xl animate-pulse" style="animation-duration: 8s;"></div>
      <div class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-gradient-to-tr from-indigo-400/20 via-purple-400/10 to-transparent rounded-full blur-3xl animate-pulse" style="animation-duration: 10s; animation-delay: 1s;"></div>
    </div>

    <div class="max-w-4xl mx-auto relative z-10">
      <!-- Page header -->
      <div class="text-center mb-12">
        <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-gradient-to-br from-purple-500 to-indigo-600 mb-6">
          <img src="/images/drip.svg" alt="" class="w-10 h-10" />
        </div>
        <h1 class="text-3xl font-bold mb-4 bg-gradient-to-r from-purple-600 to-indigo-600 dark:from-purple-400 dark:to-indigo-400 bg-clip-text text-transparent">
          .NET drip
        </h1>
        <div class="flex items-center justify-center gap-2 text-lg text-text-secondary">
          <svg class="w-5 h-5 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <time datetime={drip.data.publishDate}>{formattedDate}</time>
        </div>
      </div>

      <!-- Links list -->
      <div class="space-y-3">
        {drip.data.links?.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group block p-6 bg-white dark:bg-[#111111] border border-border rounded-lg hover:border-indigo-400 dark:hover:border-indigo-600 transition-all duration-300 hover:shadow-lg"
          >
            <div class="flex items-start gap-3">
              <div class="flex-shrink-0 mt-1">
                <img src="/images/drip.svg" alt="" class="w-4 h-5" />
              </div>
              <div class="flex-1 min-w-0">
                <h3 class="font-medium text-lg text-text-primary group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors mb-2" set:html={link.title} />
                <p class="text-sm text-text-secondary leading-relaxed" set:html={link.summary} />
              </div>
              <svg class="w-5 h-5 text-text-primary group-hover:text-indigo-600 dark:group-hover:text-indigo-400 flex-shrink-0 transition-all mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>
</Layout>
